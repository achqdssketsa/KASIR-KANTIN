rules_version = '2';

// Aturan keamanan Kantin Insya. Tempel/deploy ke Firestore: firebase deploy --only firestore
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function profilePath() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    // Staf = punya dokumen users/{uid} yang aktif
    function isStaff() { return signedIn() && exists(profilePath()) && get(profilePath()).data.active == true; }
    function isOwner() { return isStaff() && get(profilePath()).data.role == 'owner'; }
    function onlyChanges(keys) { return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys); }

    // Penanda "toko sudah disiapkan". Hanya bisa dibuat sekali; setelah itu tidak ada yang bisa jadi pemilik baru.
    match /meta/setup {
      allow read: if signedIn();
      allow create: if signedIn() && !exists(/databases/$(database)/documents/meta/setup);
    }

    match /users/{uid} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      // pemilik pertama (hanya selama toko belum disiapkan)
      allow create: if (signedIn() && request.auth.uid == uid && request.resource.data.role == 'owner'
                        && !exists(/databases/$(database)/documents/meta/setup))
                    // pemilik menambah kasir
                    || (isOwner() && request.resource.data.role == 'cashier' && request.resource.data.active == true);
      // pemilik mengaktifkan/menonaktifkan akun lain (tidak boleh mengubah peran)
      allow update: if isOwner() && uid != request.auth.uid && onlyChanges(['active']);
      allow delete: if false;
    }

    match /config/{doc} {
      allow read: if isStaff();
      allow write: if isOwner();
    }

    match /products/{id} {
      allow read: if isStaff();
      allow create: if isOwner();
      // kasir hanya boleh mengubah stok (saat menjual)
      allow update: if isOwner() || (isStaff() && onlyChanges(['stock']));
      allow delete: if false;
    }

    match /transactions/{id} {
      // pemilik melihat semua; kasir hanya transaksinya sendiri
      allow read: if isOwner() || (isStaff() && resource.data.cashier_uid == request.auth.uid);
      allow create: if isStaff() && request.resource.data.cashier_uid == request.auth.uid
                    && (isOwner() || request.resource.data.kind in ['sale', 'log']);
      // pembatalan dan perubahan lain hanya pemilik; kasir hanya menambah hitungan cetak struk miliknya
      allow update: if isOwner() || (isStaff() && resource.data.cashier_uid == request.auth.uid && onlyChanges(['prints']));
      allow delete: if false;   // catatan keuangan tidak boleh dihapus
    }
  }
}
